		part-8 = <0x40>;
		part-9 = <0x41>;
		part-10 = <0x42>;
		part-11 = <0x43>;
		phandle = <0xda>;

		conf: conf {
			pname = "conf";
			size = <0x00 0x400000>;
			mask = <0x01>;
			phandle = <0x38>;
		};

		logo: logo {
			pname = "logo";
			size = <0x00 0x2000000>;
			mask = <0x01>;
