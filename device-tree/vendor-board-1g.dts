	sd_emmc_a: sdio@d0070000 {
		status = "okay";
		compatible = "amlogic, meson-mmc-gxlx3";
		reg = <0x00 0xd0070000 0x00 0x2000>;
		interrupts = <0x00 0xd8 0x04>;
		pinctrl-names = "sdio_clk_cmd_pins", "sdio_all_pins";
		pinctrl-0 = <0x6b>;
		pinctrl-1 = <0x6c>;
