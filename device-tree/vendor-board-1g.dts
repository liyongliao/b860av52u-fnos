	reset: reset-controller@c1104404 {
		compatible = "amlogic,meson8b-reset";
		reg = <0x00 0xc1104404 0x00 0x20>;
		#reset-cells = <0x01>;
		phandle = <0xbf>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		cbus: cbus@c1100000 {
			compatible = "simple-bus";
			status = "okay";
			reg = <0x00 0xc1100000 0x00 0x100000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xc1100000 0x00 0x100000>;
			phandle = <0xc0>;

			gpio_intc: interrupt-controller@9880 {
				compatible = "amlogic,meson-gpio-intc", "amlogic,meson-gxl-gpio-intc";
				reg = <0x00 0x9880 0x00 0x10>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				amlogic,channel-interrupts = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47>;
				status = "okay";
				phandle = <0xc1>;
			};

			meson_clk_msr {
				compatible = "amlogic,gxlx3-measure";
				reg = <0x00 0x875c 0x00 0x04 0x00 0x8764 0x00 0x04>;
			};

			uart_A: serial@84c0 {
				compatible = "amlogic, meson-uart";
				reg = <0x00 0x84c0 0x00 0x18>;
				interrupts = <0x00 0x1a 0x01>;
				status = "okay";
				clocks = <0x08 0x2f>;
				clock-names = "clk_uart";
				fifosize = <0x80>;
				pinctrl-names = "default";
				pinctrl-0 = <0x1f>;
				phandle = <0xc2>;
			};

			uart_B: serial@84dc {
				compatible = "amlogic, meson-uart";
				reg = <0x00 0x84dc 0x00 0x18>;
				interrupts = <0x00 0x4b 0x01>;
				status = "disabled";
				clocks = <0x18 0x08 0x49>;
				clock-names = "clk_uart", "clk_gate";
				fifosize = <0x40>;
				pinctrl-names = "default";
				pinctrl-0 = <0x20>;
				phandle = <0xc3>;
			};

			uart_C: serial@8700 {
				compatible = "amlogic, meson-uart";
				reg = <0x00 0x8700 0x00 0x18>;
				interrupts = <0x00 0x5d 0x01>;
				status = "disabled";
				clocks = <0x18 0x08 0x5f>;
				clock-names = "clk_uart", "clk_gate";
				fifosize = <0x40>;
				pinctrl-names = "default";
				pinctrl-0 = <0x21>;
				phandle = <0xc4>;
			};

			pwm_ab: pwm@8550 {
				compatible = "amlogic,gx-ee-pwm";
				reg = <0x00 0x8550 0x00 0x1c>;
				#pwm-cells = <0x03>;
				clocks = <0x18 0x18 0x18 0x18>;
				clock-names = "clkin0", "clkin1", "clkin2", "clkin3";
				status = "disabled";
				pinctrl-names = "pwm_b_pins";
				pinctrl-0 = <0x22>;
				phandle = <0xc5>;
			};

			pwm_cd: pwm@8640 {
				compatible = "amlogic,gx-ee-pwm";
				reg = <0x00 0x8640 0x00 0x1c>;
				#pwm-cells = <0x03>;
				clocks = <0x18 0x18 0x18 0x18>;
				clock-names = "clkin0", "clkin1", "clkin2", "clkin3";
				status = "disabled";
				phandle = <0xc6>;
			};

			pwm_ef: pwm@86c0 {
				compatible = "amlogic,gx-ee-pwm";
				reg = <0x00 0x86c0 0x00 0x1c>;
				#pwm-cells = <0x03>;
				clocks = <0x18 0x18 0x18 0x18>;
				clock-names = "clkin0", "clkin1", "clkin2", "clkin3";
				status = "disabled";
				phandle = <0x61>;
			};

			i2c0: i2c@8500 {
				compatible = "amlogic,meson-i2c";
				status = "disabled";
				reg = <0x00 0x8500 0x00 0x20>;
				interrupts = <0x00 0x15 0x01>;
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				clocks = <0x08 0x7e>;
				clock-names = "clk_i2c";
				phandle = <0xc7>;
			};

			i2c1: i2c@87c0 {
				compatible = "amlogic,meson-i2c";
				status = "disabled";
				reg = <0x00 0x87c0 0x00 0x20>;
				interrupts = <0x00 0xd6 0x01>;
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				clocks = <0x08 0x7e>;
				clock-names = "clk_i2c";
				phandle = <0xc8>;
			};

			i2c2: i2c@87e0 {
				compatible = "amlogic,meson-i2c";
				status = "disabled";
				reg = <0x00 0x87e0 0x00 0x20>;
				interrupts = <0x00 0xd7 0x01>;
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				clocks = <0x08 0x7e>;
				clock-names = "clk_i2c";
				phandle = <0xc9>;
			};

			i2c3: i2c@8d20 {
				compatible = "amlogic,meson-i2c";
				status = "disabled";
				reg = <0x00 0x8d20 0x00 0x20>;
				interrupts = <0x00 0x27 0x01>;
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				clocks = <0x08 0x7e>;
				clock-names = "clk_i2c";
				phandle = <0xca>;
			};
		};

		aobus: aobus@c8100000 {
			compatible = "simple-bus";
			reg = <0x00 0xc8100000 0x00 0x100000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xc8100000 0x00 0x100000>;
			phandle = <0xcb>;

			cpu_version {
				reg = <0x00 0x220 0x00 0x04>;
			};

			uart_AO: serial@4c0 {
				compatible = "amlogic, meson-uart";
				reg = <0x00 0x4c0 0x00 0x18>;
				interrupts = <0x00 0xc1 0x01>;
				status = "okay";
				clocks = <0x18>;
				clock-names = "clk_uart";
				xtal_tick_en = <0x01>;
				fifosize = <0x40>;
				pinctrl-names = "default";
				support-sysrq = <0x00>;
				phandle = <0xcc>;
			};

			uart_AO_B: serial@4e0 {
				compatible = "amlogic, meson-uart";
				reg = <0x00 0x4e0 0x00 0x18>;
				interrupts = <0x00 0xc5 0x01>;
				status = "disable";
				clocks = <0x18>;
				clock-names = "clk_uart";
				fifosize = <0x40>;
				pinctrl-names = "default";
				pinctrl-0 = <0x23>;
				phandle = <0xcd>;
			};

			pwm_aoab: pwm@550 {
				compatible = "amlogic,gx-ao-pwm";
				reg = <0x00 0x550 0x00 0x1c>;
				#pwm-cells = <0x03>;
				clocks = <0x18 0x18 0x18 0x18>;
				clock-names = "clkin0", "clkin1", "clkin2", "clkin3";
				status = "disabled";
				phandle = <0xce>;
			};
		};

		periphs: periphs@c8834000 {
			compatible = "simple-bus";
			status = "okay";
			reg = <0x00 0xc8834000 0x00 0x2000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xc8834000 0x00 0x2000>;
			phandle = <0xcf>;

			rng {
				compatible = "amlogic,meson-rng";
				reg = <0x00 0x00 0x00 0x04>;
				quality = [03 e8];
			};
		};

		hiubus: hiubus@c883c000 {
			compatible = "simple-bus";
			status = "okay";
			reg = <0x00 0xc883c000 0x00 0x2000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xc883c000 0x00 0x2000>;
			phandle = <0xd0>;

			clkc: clock-controller@0 {
				compatible = "amlogic,gxlx3-clkc";
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				reg = <0x00 0x00 0x00 0x3db>;
				phandle = <0x08>;
			};
		};
	};

	vdac {
		compatible = "amlogic, vdac-gxlx3";
