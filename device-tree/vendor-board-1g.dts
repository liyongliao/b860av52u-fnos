			phandle = <0x3c>;
		};

		crypt: crypt {
			pname = "crypt";
			size = <0x00 0x2000000>;
			mask = <0x01>;
			phandle = <0x3d>;
		};

		misc: misc {
			pname = "misc";
			size = <0x00 0x2000000>;
			mask = <0x01>;
			phandle = <0x3e>;
		};

		boot: boot {
			pname = "boot";
			size = <0x00 0x2000000>;
			mask = <0x01>;
			phandle = <0x3f>;
		};

		system: system {
			pname = "system";
			size = <0x00 0x40000000>;
			mask = <0x01>;
			phandle = <0x40>;
		};

		env: env {
			pname = "env";
			size = <0x00 0x800000>;
